{
  "name": "@turboforge/tf-form-v2",
  "version": "0.0.1",
  "private": false,
  "description": "A web component for turboforge forms in next experience",
  "keywords": [
    "ServiceNow",
    "Next Experience UI Component",
    "@turboforge/tf-form-v2"
  ],
  "readme": "./README.md",
  "engines": {
    "node": ">=22"
  },
  "module": "src/index.js",
  "scripts": {
    "build:css": "npx tailwindcss@^3.4.17 -i src/styles/tailwind.css -o temp-tailwind.css && sed 's|/\\*[^*]*\\*\\+\\([^/*][^*]*\\*\\+\\)*/||g' temp-tailwind.css | sed '/^\\/\\*/,/\\*\\//d' | sed 's|/\\*.*\\*/||g' > src/x-312987-tf-form-v-2/styles/_tailwind-generated.css && rm temp-tailwind.css",
    "build:css-watch": "npx tailwindcss@^3.4.17 -i src/styles/tailwind.css -o src/x-312987-tf-form-v-2/styles/_tailwind-generated.css --watch",
    "build:css-prod": "npx tailwindcss@^3.4.17 -i src/styles/tailwind.css -o temp-tailwind.css && npx postcss temp-tailwind.css --config postcss.config.build.js -o src/x-312987-tf-form-v-2/styles/_tailwind-generated.css && rm temp-tailwind.css"
  },
  "dependencies": {
    "@quixomatic/ui-renderer-react-simple": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@servicenow/sass-kit": "latest",
    "@servicenow/ui-core": "24.1.1",
    "@servicenow/ui-effect-http": "^24.1.1",
    "@servicenow/ui-renderer-react": "file:src/node_modules/@servicenow/ui-renderer-react",
    "@servicenow/ui-renderer-snabbdom": "24.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@babel/runtime": "7.25.7",
    "@tailwindcss/postcss": "^4.1.11",
    "ajv": "^6.12.6",
    "autoprefixer": "^10.4.21",
    "babel-plugin-module-resolver": "^5.0.2",
    "cssnano": "^7.1.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-discard-comments": "^7.0.4",
    "sass": "1.53.0"
  }
}
